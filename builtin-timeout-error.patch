 use super::models;
 
+/// The sidecar did not answer within the time it was given. A typed error (same message as before) so callers
+/// can tell a slow model from a broken one without matching on text.
+#[derive(Debug)]
+pub struct GenerationTimedOut(pub Duration);
+
+impl std::fmt::Display for GenerationTimedOut {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "Request timed out after {:?}", self.0)
+    }
+}
+
+impl std::error::Error for GenerationTimedOut {}
