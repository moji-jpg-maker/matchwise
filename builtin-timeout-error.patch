@@ -1171,3 +1171,13 @@ mod selection {
         assert_eq!(rec.0.lock().unwrap().first(), Some(&TaskProfile::Extraction));
     }
 }
+
+#[test]
+fn a_built_in_timeout_keeps_its_own_error_and_other_failures_stay_server_errors() {
+    use crate::summary::summary_engine::sidecar::GenerationTimedOut;
+    let slow = anyhow::Error::new(GenerationTimedOut(std::time::Duration::from_secs(180))).context("generating");
+    assert_eq!(AiError::from_builtin(slow), AiError::TimedOut(180));
+    assert!(matches!(AiError::from_builtin(anyhow::anyhow!("boom")), AiError::Server(m) if m == "boom"));
+    let shown = AiError::TimedOut(180).to_string();
+    assert!(shown.contains("180 seconds") && !shown.contains("provider returned an error"));
+}
