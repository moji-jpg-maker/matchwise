# Matchwise local configuration.
# Copy to `.env` (same directory as this file) and fill in. `.env` is gitignored.
#
# Loaded automatically by `frontend/scripts/load-env.js`, which the
# `tauri:dev` / `tauri:build` npm scripts run before starting Tauri, and by
# `frontend/build.ps1` on Windows. A variable already present in the real
# environment always wins over the value in this file.

# ---------------------------------------------------------------------------
# Database encryption
# ---------------------------------------------------------------------------
# 64 hex characters (32 bytes). Overrides the OS credential store.
# Needed on WSL / headless Linux where no Secret Service daemon is running.
# If omitted, a key is read from (or created in) the OS credential store.
# Keep a copy: without the key an encrypted database cannot be read.
MATCHWISE_DB_KEY=

# ---------------------------------------------------------------------------
# Telegram (optional)
# ---------------------------------------------------------------------------
# BotFather token, `123456789:AA...`. Only needed on WSL / headless machines;
# otherwise store it from the Telegram page in the app.
MATCHWISE_TELEGRAM_TOKEN=

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
# Only for a cloud provider on WSL / headless machines; otherwise store it
# from the AI page in the app.
MATCHWISE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Windows code signing (optional)
# ---------------------------------------------------------------------------
# Only needed when building with `frontend/build.ps1 -Sign`. The signCommand in
# src-tauri/tauri.conf.json reads DIGICERT_KEYPAIR_ALIAS and skips signing when
# it is unset, so an unsigned local build needs none of these.
# Requires DigiCert KeyLocker and `smctl` on PATH, signed in.
DIGICERT_KEYPAIR_ALIAS=
SM_HOST=
SM_API_KEY=
SM_CLIENT_CERT_FILE=
SM_CLIENT_CERT_PASSWORD=
SM_CODE_SIGNING_CERT_SHA1_HASH=
